# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
# `docs/` is Foundry's default for `forge doc` output, but it is ALSO where GitHub Pages
# serves from, and the landing page and app live there. Ignore only what forge generates.
docs/book/
docs/src/

# Dotenv file
.env
.env.*
!.env.example

# Brevis prover artifacts (large, regenerable)
brevis/prover/circuitOut/
circuitOut/
kzgsrs/
node_modules/
brevis/contracts/artifacts/
brevis/contracts/cache/
brevis/contracts/typechain/
brevis/**/node_modules/
.env

# Local-only project guardrails, deliberately untracked
CLAUDE.md

# gate.sh scratch output
.gate-tmp/

# ---------------------------------------------------------------------------
# Kept locally, deliberately not part of the submission.
#
# analysis/ holds two kinds of file. The EVIDENCE a claim rests on is tracked and
# linked from the README. The working records below are how we got there: planning,
# checklists, superseded drafts, competitive checks and video preparation. They are
# useful to us and noise to a reviewer, so they stay on disk and out of the repo.
# ---------------------------------------------------------------------------
analysis/roadmap.md
analysis/submission-checklist.md
analysis/t1-runbook.md
analysis/progress-update-1.md
analysis/recording-script.md
analysis/video-script.md
analysis/rfh-collision-check.md
analysis/circuit-claim-decision.md
analysis/sensitivity-preliminary.md
analysis/design-source/

# Upstream's Hardhat quickstart. Tenure does not use it, and it carried upstream's own
# Sepolia deployment records, which read as if they were ours. The single file we need
# is vendored at src/lib/BrevisAppZkOnly.sol. See brevis/ATTRIBUTION.md.
brevis/contracts/

# Foundry writes a timestamped copy beside run-latest.json. One record is enough.
broadcast/**/run-[0-9]*.json
