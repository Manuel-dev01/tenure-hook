# Force LF for everything textual. Without this, a Windows checkout gets CRLF while
# CI (Linux) gets LF, so `forge fmt --check` passes locally and fails in CI — or the
# reverse — with a diff that shows every line changed and no visible cause.
* text=auto eol=lf

*.sol   text eol=lf
*.go    text eol=lf
*.ts    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
