/// @notice Probe hook. Observes only. Prices nothing.
///         Every swap through it records what the PoolManager's transient state
///         looked like at beforeSwap time.
contract ProbeHook is BaseHook {
    struct Observation {
        address sender;          // the locker (usually the router, NOT the EOA)
        uint256 nonzeroDeltas;   // how many currencies the locker is out of balance on
        int256  deltaCurrency0;  // locker's outstanding delta in this pool's token0
        int256  deltaCurrency1;  // locker's outstanding delta in this pool's token1
        bool    sawPriorTouch;   // hook-local transient flag from an earlier leg
        uint256 legIndex;        // 0 for first touch this tx, 1 for second, etc.
    }

    Observation[] public observations;

    // Hook-local transient slots (EIP-1153, transaction-scoped, cleared at tx end).
    bytes32 constant T_TOUCHED   = keccak256("roundtrip.touched");
    bytes32 constant T_LEG_INDEX = keccak256("roundtrip.legIndex");

    constructor(IPoolManager _pm) BaseHook(_pm) {}

    function getHookPermissions() public pure override returns (Hooks.Permissions memory) {
        return Hooks.Permissions({
            beforeInitialize: false, afterInitialize: false,
            beforeAddLiquidity: false, afterAddLiquidity: false,
            beforeRemoveLiquidity: false, afterRemoveLiquidity: false,
            beforeSwap: true, afterSwap: false,
            beforeDonate: false, afterDonate: false,
            beforeSwapReturnDelta: false, afterSwapReturnDelta: false,
            afterAddLiquidityReturnDelta: false, afterRemoveLiquidityReturnDelta: false
        });
    }

    function _beforeSwap(address sender, PoolKey calldata key, IPoolManager.SwapParams calldata, bytes calldata)
        internal
        override
        returns (bytes4, BeforeSwapDelta, uint24)
    {
        // --- Q1: hook-local transient persistence across legs ---
        bool touched;
        uint256 leg;
        assembly {
            touched := tload(T_TOUCHED)
            leg := tload(T_LEG_INDEX)
        }
        assembly {
            tstore(T_TOUCHED, 1)
            tstore(T_LEG_INDEX, add(leg, 1))
        }

        // --- Q2: read the PoolManager's OWN transient state from inside the hook ---
        // NOTE: verify both of these against v4-core source before trusting the output.
        //   - NonzeroDeltaCount.NONZERO_DELTA_COUNT_SLOT is a constant in
        //     v4-core/src/libraries/NonzeroDeltaCount.sol
        //   - the per-(target,currency) delta slot derivation lives in
        //     v4-core/src/libraries/CurrencyDelta.sol — mirror _computeSlot exactly,
        //     do NOT guess the preimage layout.
        uint256 nonzero = _readNonzeroDeltaCount();
        int256 d0 = _readDelta(sender, key.currency0);
        int256 d1 = _readDelta(sender, key.currency1);

        observations.push(Observation({
            sender: sender,
            nonzeroDeltas: nonzero,
            deltaCurrency0: d0,
            deltaCurrency1: d1,
            sawPriorTouch: touched,
            legIndex: leg
        }));

        return (BaseHook.beforeSwap.selector, BeforeSwapDeltaLibrary.ZERO_DELTA, 0);
    }

    function _readNonzeroDeltaCount() internal view returns (uint256) {
        bytes32 slot = NONZERO_DELTA_COUNT_SLOT; // import or copy from v4-core
        return uint256(IExttload(address(poolManager)).exttload(slot));
    }

    function _readDelta(address target, Currency currency) internal view returns (int256) {
        bytes32 slot;
        assembly {
            mstore(0, target)
            mstore(32, currency)
            slot := keccak256(0, 64)
        }
        return int256(uint256(IExttload(address(poolManager)).exttload(slot)));
    }

    function observationCount() external view returns (uint256) { return observations.length; }
    function clear() external { delete observations; }
}

